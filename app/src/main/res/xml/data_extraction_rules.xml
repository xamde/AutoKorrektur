<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for AutoKorrektur:
   Explicitly exclude temporary cache, ML weights, and private images from cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
# The one place in this repo that names the domain. The server itself (Caddy, DNS, headers) is
# configured in the infrastructure repo ~/files/work/server (role autokorrektur,
# dns/zones/autokorrektur.org.yml); a domain change happens there first.
# The SSH target for deploy.sh (VPS_HOST=user@host) lives in the gitignored site/deploy.local.env,
# not here: this repo is public.
SITE_DOMAIN=autokorrektur.org
VPS_WWW=/srv/autokorrektur/www
